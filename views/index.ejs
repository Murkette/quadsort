<%- include('partials/head') %>
<section class="lhero">
  <div class="hero-copy">
    <% if (weekly) { %><span class="pill-note"><i></i><%= weekly.toLocaleString('en-US') %> puzzles made this week</span><% } %>
    <h1>Four groups of four.</h1>
    <p class="lede">Make a word puzzle, share one link, see how everyone did.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/create">Make a puzzle</a>
      <a class="btn" href="/random">Play one</a>
    </div>
    <span class="fine-l">Free. Players never need an account.</span>
  </div>

  <div class="demo panel" id="demo">
    <div class="demo-top"><b>Warm-up: two groups</b><span>Tap four</span></div>
    <div class="board">
      <div class="toast" id="demo-toast" role="status" hidden></div>
      <div class="rows" id="demo-rows"></div>
      <div class="grid" id="demo-grid"></div>
    </div>
    <div class="demo-done" id="demo-done" hidden>
      <b>Now make your own.</b>
      <a class="btn btn-sm" href="/create">Make one</a>
    </div>
    <span class="hint" id="demo-hint">Find the two groups of four.</span>
  </div>
</section>

<% if (todays) { %>
<section class="band">
  <a class="daily-card" href="/daily">
    <div class="dc-copy">
      <span class="eyebrow">Today's Daily · #<%= todays.number %> · <%= todays.label %></span>
      <h2><%= todays.title %></h2>
      <p>by <%= todays.by %><%= todays.plays ? ' · ' + todays.plays.toLocaleString('en-US') + ' played' : '' %><%= todays.plays >= 5 ? ' · ' + Math.round(todays.solveRate * 100) + '% solve it' : '' %></p>
      <span class="btn">Play today's Daily</span>
    </div>
    <div class="cover" aria-hidden="true"><% for (var i = 0; i < 8; i++) { %><span class="lv" data-level="<%= todays.id.charCodeAt(i % todays.id.length) % 4 + 1 %>"></span><% } %></div>
  </a>
</section>
<% } %>
<% if (picks.length) { %>
<section class="band">
  <div class="band-head">
    <div>
      <h2>Staff picks.</h2>
      <p>Chosen by the Quadsort team.</p>
    </div>
  </div>
  <div class="pgrid2 four"><% picks.forEach(function (p) { %><%- include('partials/card', { p: p, rate: rate, LEVELS: LEVELS }) %><% }) %></div>
</section>
<% } %>

<section class="band">
  <div class="band-head">
    <div>
      <h2>Trending</h2>
      <p>What people are playing this week.</p>
    </div>
    <a class="seeall" href="/browse" aria-label="See all puzzles">See all</a>
  </div>
  <div class="pgrid2 four"><% trending.forEach(function (p) { %><%- include('partials/card', { p: p, rate: rate, LEVELS: LEVELS }) %><% }) %></div>
</section>

<section class="band">
  <h2>How it works</h2>
  <div class="steps">
    <div class="step"><span class="num lv" data-level="1" aria-hidden="true">1</span><h3>Write it</h3><p>Sixteen words in four groups, each with a difficulty from Gentle to Devious. It takes about two minutes.</p></div>
    <div class="step"><span class="num lv" data-level="2" aria-hidden="true">2</span><h3>Share it</h3><p>You get one short link. Bio, story, newsletter, group chat. Nobody has to sign up to play.</p></div>
    <div class="step"><span class="num lv" data-level="3" aria-hidden="true">3</span><h3>See how they did</h3><p>Solve rate, average mistakes, and the wrong guess most people make.</p></div>
  </div>
</section>

<section class="band">
  <div class="creator-band">
    <div class="cb-copy">
      <span class="eyebrow">For creators, teachers, group chats</span>
      <h2>Your puzzle, with your name on it.</h2>
      <p>Every puzzle credits you and links back to your profile. Results cards send players straight to “more by you”.</p>
      <a class="btn" href="/create">Start making</a>
    </div>
    <div class="cb-stats">
      <div><b>2 min</b><span>to build one</span></div>
      <div><b>0</b><span>accounts needed to play</span></div>
      <div><b>Live</b><span>solve rate &amp; mistakes</span></div>
      <div><b>1 link</b><span>quadsort.com/p/…</span></div>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
