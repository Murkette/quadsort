<%- include('partials/head') %>
<section class="auth">
  <h1>Forgot your password?</h1>
  <p class="lede">Enter your email and we will send a link to choose a new one.</p>
  <form class="panel" method="post" action="/forgot" novalidate>
    <div class="field">
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" value="<%= email %>" autocomplete="email" autocapitalize="none">
    </div>
    <button class="btn btn-primary btn-wide" type="submit">Send the link</button>
  </form>
  <p class="alt"><a href="/login">Back to log in</a></p>
</section>
<%- include('partials/foot') %>
