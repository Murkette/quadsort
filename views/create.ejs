<%- include('partials/head') %>
<div class="create" id="create" data-id="<%= puzzleId %>" data-plays="<%= plays %>" data-auth="<%= user ? 1 : 0 %>" data-name="<%= user ? user.display_name : '' %>">
  <form class="create-main" id="form" novalidate autocomplete="off">
    <div class="create-head">
      <h1><%= puzzleId ? 'Edit your puzzle' : 'Make a puzzle' %></h1>
      <p>Four groups of four. Make one obvious and one evil. Everyone else does.</p>
    </div>

    <section class="panel">
      <h2>The basics</h2>
      <div class="basics one">
        <div class="field">
          <label for="f-title">Puzzle title</label>
          <input id="f-title" value="<%= form.title %>" placeholder="Group Chat Chaos">
          <span class="ferr" data-for="title" aria-live="polite"></span>
        </div>
        <div class="field">
          <label for="f-desc">Description <span class="opt">(optional)</span></label>
          <input id="f-desc" value="<%= form.description %>" placeholder="A little taunt for the players">
          <span class="ferr" data-for="description" aria-live="polite"></span>
        </div>
      </div>
      <fieldset class="topics">
        <legend>Topics <span class="opt">(optional, up to 3)</span></legend>
        <div class="topic-list">
          <% TAGS.forEach(function (t) { %><label class="topic"><input type="checkbox" name="tag" value="<%= t.id %>"<%= form.tags.includes(t.id) ? ' checked' : '' %>><span><%= t.label %></span></label>
          <% }) %>
        </div>
        <span class="ferr" data-for="tags" aria-live="polite"></span>
      </fieldset>
    </section>

    <section class="groups-section">
      <div class="groups-head">
        <h2>Your four groups</h2>
        <span>Easiest at the top, most devious at the bottom.</span>
      </div>
      <div class="ggrid">
        <% form.groups.forEach(function (g, i) { %>
        <div class="gcard" data-i="<%= i %>" style="order: <%= g.level %>">
          <div class="gband lv" data-level="<%= g.level %>">
            <span class="gtitle"><span class="shape" data-level="<%= g.level %>" aria-hidden="true"></span>Group <b class="gpos"><%= g.level %></b></span>
            <label class="diff">Difficulty
              <select class="glevel" data-prev="<%= g.level %>">
                <% LEVELS.forEach(function (name, k) { %><option value="<%= k + 1 %>"<%= g.level === k + 1 ? ' selected' : '' %>><%= name %></option><% }) %>
              </select>
            </label>
          </div>
          <div class="gbody">
            <div class="field">
              <label for="g<%= i %>-name">Category name</label>
              <input class="gname" id="g<%= i %>-name" value="<%= g.name %>" placeholder="What links them?">
            </div>
            <div class="gwords">
              <% [0, 1, 2, 3].forEach(function (j) { %>
              <label class="wlabel"><span class="wn" aria-hidden="true"><%= j + 1 %></span><span class="sr">Group <%= i + 1 %>, word <%= j + 1 %></span><input class="wi" value="<%= g.words[j] || '' %>" placeholder="Word"><span class="wc" aria-hidden="true"></span></label>
              <% }) %>
            </div>
            <div class="gerrs" aria-live="polite"></div>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
  </form>

  <aside class="create-side">
    <div class="panel">
      <div class="pv-top">
        <h2>Live preview</h2>
        <button type="button" class="btn btn-sm" id="reshuffle">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/></svg>
          Shuffle</button>
      </div>
      <div class="pv-meta"><span id="pv-title"></span><span id="pv-by"></span></div>
      <div class="pgrid" id="pgrid" aria-hidden="true"></div>
      <span class="hint">Shuffled the way players will see it. Tiles turn orange if a word won’t fit.</span>
    </div>

    <div class="panel" id="publish-panel">
      <div id="issues" hidden>
        <h3 id="issues-title"></h3>
        <ul id="issues-list"></ul>
      </div>
      <p class="ready" id="ready" hidden>All sixteen present and correct. Suspicious.</p>
      <% if (plays > 0) { %><p class="warn-note">⚠ <%= plays %> player<%= plays === 1 ? ' has' : 's have' %> played this. Changing the words or groups clears the plays and stats.</p><% } %>
      <p class="as"><% if (user) { %>Publishing as <b><%= user.display_name %></b> · <a href="/settings">change</a><% } else { %>You’ll make a free account when you publish. Your puzzle waits for you.<% } %></p>
      <button type="button" class="btn btn-primary btn-wide" id="publish" disabled><%= puzzleId ? 'Save changes' : 'Publish puzzle' %></button>
      <p class="pub-msg" id="pub-msg" role="alert" hidden></p>
    </div>
  </aside>
</div>

<div class="published" id="published" hidden>
  <div class="pub-top">
    <%- include('partials/mark') %>
    <h1 id="pub-h">Published.</h1>
    <p id="pub-sub">Now go and ruin someone’s afternoon.</p>
  </div>
  <div class="panel">
    <label for="share-link">Your share link</label>
    <div class="linkrow">
      <input id="share-link" readonly>
      <button type="button" class="btn btn-ink" id="pub-copy">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        <span id="pub-copy-label">Copy link</span></button>
    </div>
    <span class="sharelabel">Share it</span>
    <div class="sharegrid" id="sharegrid"></div>
    <span class="hint">Instagram, TikTok and Discord don’t take share links from websites. Copy the link and paste it into your bio, story or chat.</span>
  </div>
  <div class="pub-actions">
    <a class="btn btn-primary" id="pub-play" href="/">Play it yourself</a>
    <a class="btn" href="/create">Make another</a>
  </div>
  <button type="button" class="back" id="pub-edit">Edit puzzle</button>
</div>
<%- include('partials/foot') %>
